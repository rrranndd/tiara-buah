# ======================
# Database Configuration
# ======================
DB_HOST=localhost          # jika nanti pakai hosting MySQL, ganti ke host public DB
DB_PORT=3306               # default MySQL port
DB_USER=root
DB_PASS=admin123
DB_NAME=tiara_buah_db

# ======================
# Server Configuration
# ======================
PORT=4000
NODE_ENV=production        # pastikan ini diisi 'production' saat deploy

# ======================
# Application Secrets
# ======================
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:3000   # nanti ubah ke domain React-mu (misal https://tiarabuah.com)

# ======================
# CORS (optional)
# ======================
ALLOWED_ORIGIN=http://localhost:3000
